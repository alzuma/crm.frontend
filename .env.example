# How the frontend reaches the CRM backend.
# Copy this file to .env and adjust for your setup.

# Address the browser calls the backend at. Leave it unset (or empty) to use
# the same origin, which is what development and production set up.
# VITE_API_BASE_URL=https://api.example.com

# Development only: where the Vite dev server proxies /api and /health to.
VITE_API_PROXY_TARGET=http://localhost:5080
